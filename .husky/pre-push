#!/usr/bin/env sh
set -e

BLUE='\033[34m'
GREEN='\033[32m'
YELLOW='\033[33m'
RESET='\033[39m'

ZERO='0000000000000000000000000000000000000000'

# Git feeds the refs being pushed on stdin as:
#   <local ref> <local sha> <remote ref> <remote sha>
# If every ref being pushed already matches its remote sha, there is
# nothing new to push, so we can skip the expensive checks.
has_changes=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip empty lines (e.g. when stdin is empty).
  [ -z "$local_ref" ] && continue

  # Deleting a remote ref: nothing to check.
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi

  # New branch on remote, or local differs from remote -> there are changes.
  if [ "$local_sha" != "$remote_sha" ]; then
    has_changes=1
    break
  fi
done

if [ "$has_changes" -eq 0 ]; then
  printf "\n${YELLOW}No differences between local and remote. Skipping checks.${RESET}\n"
  exit 0
fi

printf "\n${BLUE}------------------${RESET}\n"
printf "${BLUE}Step 1: pnpm check${RESET}\n"
printf "${BLUE}------------------${RESET}\n"


pnpm check
