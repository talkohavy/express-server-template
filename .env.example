# Optional environment variables (defaults shown)
PORT=8000
SERVICE_NAME=express-server-template
MICRO_SERVICES_PROTOCOL=direct

# Postgres
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/express_server_template
SHOULD_MIGRATE_POSTGRES=true

# Redis
REDIS_CONNECTION_STRING=redis://localhost:6379

# Logger
LOG_LEVEL=debug
LOG_ENV=dev
USE_PRETTY_PRINT=true

# Cookies
IS_SECURE=false
# DOMAIN=localhost

# CORS: false also accepts any subdomain of the main domain, not just the exact allowed origins
IS_STRICT_CORS=true

# Return raw error messages from failed micro-service calls to the client (never in production)
EXPOSE_INTERNAL_ERRORS=true

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=


# Optional: choose socket.io or ws
# WEBSOCKET_MODULE=socket.io
