{
  "name": "express-server-template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "tsx watch --env-file-if-exists=.env src/initServer.ts",
    "build": "node build.config.mjs",
    "start": "node --env-file=.env dist/index.js",
    "tsc": "tsc -p tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:biome": "pnpx @biomejs/biome lint --error-on-warnings ./src",
    "lint:biome:fix": "pnpx @biomejs/biome lint --write ./src",
    "format": "pnpx @biomejs/biome format ./src",
    "format:fix": "pnpx @biomejs/biome format ./src --write",
    "format:prettier": "prettier . --check --config .prettierrc.mjs --ignore-path .prettierignore",
    "format:prettier:fix": "prettier . --write --config .prettierrc.mjs --ignore-path .prettierignore",
    "test": "jest",
    "test:cov": "jest --coverage",
    "check": "npm run lint && npm run lint:biome && npm run format && npm run tsc && npm run test",
    "benchmark": "node --env-file=.env --import tsx benchmark/benchmark.ts",
    "benchmark:quick": "concurrently -k -s first \"node --env-file=.env --import tsx src/initServer.ts\" \"npx autocannon -c 100 -d 5 -p 10 http://localhost:8000/api/health-check\"",
    "k6:smoke": "k6 run toolbox/benchmark/k6/smoke-test.js",
    "k6:load": "k6 run toolbox/benchmark/k6/load-test.js",
    "k6:stress": "k6 run toolbox/benchmark/k6/stress-test.js",
    "k6:health": "k6 run toolbox/benchmark/k6/health-check.js",
    "proto:lint": "cd src/modules/backend/proto && buf lint",
    "proto:gen": "cd src/modules/backend/proto && buf generate",
    "proto:break": "cd src/modules/backend/proto && buf breaking"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@faker-js/faker": "^10.6.0",
    "@grpc/grpc-js": "^1.14.6",
    "@socket.io/admin-ui": "^0.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@talkohavy/lodash": "^1.5.0",
    "api-opener": "^2.0.1",
    "color-my-json": "^0.0.9",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "mongoose": "^9.11.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@bufbuild/buf": "^1.73.0",
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/k6": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@12.11.2"
}
